FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

COPY TodoApp/ TodoApp/
COPY TodoApp.Tests/ TodoApp.Tests/

# Build both the test project and its application reference. The fixture
# reads appsettings.json, so copy the TEST configuration to the test output.
RUN dotnet build TodoApp.Tests/TodoApp.Tests.csproj --configuration Release \
    && cp TodoApp.Tests/appsettings.json TodoApp.Tests/bin/Release/net10.0/appsettings.json

WORKDIR /src/TodoApp.Tests/bin/Release/net10.0
ENTRYPOINT ["dotnet", "test", "/src/TodoApp.Tests/TodoApp.Tests.csproj", "--configuration", "Release", "--no-build", "--no-restore"]
